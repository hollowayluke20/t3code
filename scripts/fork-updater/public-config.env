# Public (non-secret) T3 Connect settings that upstream bakes into its releases. Without them the
# fork build has no T3 Connect and `t3 status` shows the machine as not connected. Same values the
# official 0.1.6 app ships (read from its public client bundle); the telemetry token is deliberately not copied.
T3CODE_RELAY_URL=https://relay.t3.codes
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r
