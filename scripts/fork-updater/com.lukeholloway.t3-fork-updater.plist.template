<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lukeholloway.t3-fork-updater</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>__REPO__/scripts/fork-updater/fork-updater.mjs</string>
		<string>tick</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:__HOME__/Development/t3code-tools/node_modules/.bin:__HOME__/.local/bin:__HOME__/.t3/bin:/usr/bin:/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/.t3-fork-updater/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.t3-fork-updater/launchd.log</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
